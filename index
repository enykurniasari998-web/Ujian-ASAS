                    const isChecked = Array.isArray(userAnswers[q.id]) && userAnswers[q.id].includes(opt);
                    return (
                      <label key={oIdx} className={`flex items-start gap-3 p-4 rounded-xl border-2 cursor-pointer transition-all ${isChecked ? 'border-amber-500 bg-amber-50' : 'border-slate-100 hover:border-slate-200 hover:bg-slate-50'}`}>
                        <div className="mt-0.5">
                           <div className={`w-5 h-5 rounded border-2 flex items-center justify-center ${isChecked ? 'border-amber-500 bg-amber-500' : 'border-slate-300'}`}>
                              {isChecked && <IconCheck className="text-white w-4 h-4" />}
                           </div>
                        </div>
                        <span className="text-slate-700 leading-relaxed">{opt}</span>
                        <input type="checkbox" className="hidden" checked={isChecked} onChange={(e) => {
                          let curr = Array.isArray(userAnswers[q.id]) ? [...userAnswers[q.id]] : [];
                          if (e.target.checked) curr.push(opt);
                          else curr = curr.filter(item => item !== opt);
                          handleAnswerChange(curr);
                        }}/>
                      </label>
                    )
                  })}
                </div>
              )}

              {q.type === 'matching' && (
                <div className="space-y-4">
                  {q.pairs.map((pair, pIdx) => {
                    const currentAnsObj = userAnswers[q.id] || {};
                    return (
                      <div key={pIdx} className="flex flex-col md:flex-row gap-4 items-center bg-slate-50 p-4 rounded-xl border border-slate-100">
                        <div className="w-full md:w-1/2 font-medium text-slate-700">{pair.left}</div>
                        <div className="hidden md:block text-slate-400">➔</div>
                        <select 
                          className="w-full md:w-1/2 p-3 rounded-lg border-2 border-slate-200 outline-none focus:border-emerald-500 bg-white"
                          value={currentAnsObj[pair.left] || ''}
                          onChange={(e) => {
                            handleAnswerChange({...currentAnsObj, [pair.left]: e.target.value});
                          }}
                        >
                          <option value="" disabled>Pilih Pasangan...</option>
                          {q.optionsRight.map(opt => <option key={opt} value={opt}>{opt}</option>)}
                        </select>
                      </div>
                    )
                  })}
                </div>
              )}

              {q.type === 'isian' && (
                <div>
                  <input 
                    type="text"
                    value={userAnswers[q.id] || ''}
                    onChange={(e) => handleAnswerChange(e.target.value)}
                    placeholder="Ketik jawaban singkat Anda di sini..."
                    className="w-full p-4 text-lg border-2 border-slate-200 rounded-xl outline-none focus:border-emerald-500 focus:ring-4 ring-emerald-100 transition"
                  />
                </div>
              )}

            </div>
          </div>
          
          {/* Footer Controls */}
          <div className="p-4 border-t bg-slate-50 flex justify-between items-center rounded-b-xl">
             <button 
               onClick={() => setCurrentIdx(Math.max(0, currentIdx - 1))}
               disabled={currentIdx === 0}
               className="px-6 py-2.5 rounded-lg font-semibold text-slate-600 disabled:opacity-50 hover:bg-slate-200 transition"
             >
               Kembali
             </button>
             
             {currentIdx < questions.length - 1 ? (
                <button 
                  onClick={() => setCurrentIdx(currentIdx + 1)}
                  className="px-8 py-2.5 rounded-lg font-bold bg-emerald-600 text-white hover:bg-emerald-700 shadow-md transition"
                >
                  Selanjutnya
                </button>
             ) : (
                <button 
                  onClick={() => {
                    if (window.confirm('Yakin ingin menyelesaikan ujian sekarang?')) {
                      submitQuiz();
                    }
                  }}
                  className="px-8 py-2.5 rounded-lg font-bold bg-amber-500 text-white hover:bg-amber-600 shadow-md transition"
                >
                  Kumpulkan Jawaban
                </button>
             )}
          </div>
        </div>
      </main>
    </div>
  );
}


function ResultScreen({ score, currentUser, onLogout }) {
  const isPass = score >= 80;

  const downloadResult = () => {
    const content = `
REKAPITULASI HASIL ASESMEN SUMATIF IPA
======================================
Nama Lengkap    : ${currentUser.name}
Kelas           : ${currentUser.class}
Nomor Presensi  : ${currentUser.presensi}
--------------------------------------
Nilai Akhir     : ${score}
Status KKM (80) : ${isPass ? 'TUNTAS' : 'REMEDIAL'}
--------------------------------------
Dokumen ini dicetak otomatis dari sistem Asesmen MTsN 1 Kota Malang.
    `;
    const blob = new Blob([content], { type: 'text/plain' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `Hasil_IPA_${currentUser.name}_${currentUser.class}.txt`;
    a.click();
    URL.revokeObjectURL(url);
  };

  return (
    <div className="min-h-screen bg-slate-50 flex items-center justify-center p-4">
      <div className="bg-white max-w-lg w-full rounded-3xl shadow-2xl overflow-hidden text-center">
        <div className={`p-10 text-white ${isPass ? 'bg-emerald-500' : 'bg-red-500'}`}>
          <div className="w-24 h-24 mx-auto bg-white/20 rounded-full flex items-center justify-center backdrop-blur-sm mb-4">
            <span className="text-5xl font-black">{score}</span>
          </div>
          <h2 className="text-2xl font-bold mb-1">{isPass ? 'Selamat, Anda Tuntas!' : 'Anda Harus Remedial'}</h2>
          <p className="opacity-90">KKM Asesmen ini adalah 80</p>
        </div>
        
        <div className="p-8">
          <div className="space-y-3 mb-8 text-left bg-slate-50 p-4 rounded-xl border border-slate-100 text-slate-700">
            <div className="flex justify-between border-b border-slate-200 pb-2">
              <span className="text-slate-500">Nama Siswa</span>
              <span className="font-semibold">{currentUser.name}</span>
            </div>
            <div className="flex justify-between border-b border-slate-200 pb-2">
              <span className="text-slate-500">Kelas</span>
              <span className="font-semibold">{currentUser.class}</span>
            </div>
            <div className="flex justify-between">
              <span className="text-slate-500">No. Presensi</span>
              <span className="font-semibold">{currentUser.presensi}</span>
            </div>
          </div>

          <div className="flex flex-col gap-3">
             <button onClick={downloadResult} className="w-full bg-slate-800 hover:bg-slate-900 text-white font-bold py-3 rounded-xl transition shadow-md">
               Download Hasil (TXT)
             </button>
             <button onClick={onLogout} className="w-full bg-white border-2 border-slate-200 hover:bg-slate-50 text-slate-600 font-bold py-3 rounded-xl transition">
               Keluar
             </button>
          </div>
        </div>
      </div>
    </div>
  );
}