export default function App() {
  const [currentUser, setCurrentUser] = useState(null); // {role, name, class, presensi}
  const [adminPassword, setAdminPassword] = useState('admin123');
  const [questions, setQuestions] = useState(INITIAL_QUESTIONS);
  const [logoUrl, setLogoUrl] = useState(DEFAULT_LOGO);
  
  // Track students who have taken the quiz (Name_Class combination as key)
  const [completedStudents, setCompletedStudents] = useState({}); 

  // Quiz State
  const [quizState, setQuizState] = useState('idle'); // idle, intro, in_progress, finished
  const [userAnswers, setUserAnswers] = useState({});
  const [score, setScore] = useState(0);
  const [timeRemaining, setTimeRemaining] = useState(1800); // 30 minutes
  
  // UI State
  const [toastMessage, setToastMessage] = useState('');

  const showToast = (msg) => {
    setToastMessage(msg);
    setTimeout(() => setToastMessage(''), 3000);
  };

  const handleLogout = () => {
    setCurrentUser(null);
    setQuizState('idle');
    setUserAnswers({});
  };


  const startQuiz = () => {
    setTimeRemaining(1800);
    setUserAnswers({});
    setQuizState('in_progress');
  };

  const submitQuiz = () => {
    let calculatedScore = 0;

    questions.forEach(q => {
      const uAns = userAnswers[q.id];
      if (!uAns) return;

      if (q.type === 'pg') {
        if (uAns === q.answer) calculatedScore += 4;
      } 
      else if (q.type === 'pg_kompleks') {
        if (Array.isArray(uAns)) {
          uAns.forEach(ans => {
            if (q.answer.includes(ans)) calculatedScore += 4; // 2 correct answers = max 8 pts
          });
          // Penalize for wrong extra choices? For simplicity, we just check matches.
          // Better logic: if they pick exactly the right ones.
          const isExactMatch = uAns.length === q.answer.length && uAns.every(v => q.answer.includes(v));
          // We'll stick to 4 points per correct choice selected.
        }
      }
      else if (q.type === 'matching') {
        if (typeof uAns === 'object') {
          Object.keys(uAns).forEach(leftItem => {
            if (q.answers[leftItem] === uAns[leftItem]) {
              calculatedScore += 2; // 4 pairs * 2 = 8 pts
            }
          });
        }
      }
      else if (q.type === 'isian') {
        const cleanedAns = String(uAns).trim().toLowerCase();
        if (q.answer.includes(cleanedAns)) {
          calculatedScore += 8;
        }
      }
    });

    setScore(calculatedScore);
    setQuizState('finished');

    // Save completion record if it's a real student
    if (currentUser.role === 'student') {
      const studentKey = `${currentUser.name}_${currentUser.class}`;
      setCompletedStudents(prev => ({
        ...prev,
        [studentKey]: {
          score: calculatedScore,
          date: new Date().toISOString()
        }
      }));
    }
  };

  // Timer Effect
  useEffect(() => {
    let timer;
    if (quizState === 'in_progress' && timeRemaining > 0) {
      timer = setInterval(() => {
        setTimeRemaining(prev => prev - 1);
      }, 1000);
    } else if (quizState === 'in_progress' && timeRemaining <= 0) {
      submitQuiz(); // Auto submit
    }
    return () => clearInterval(timer);
  }, [quizState, timeRemaining]);



  if (!currentUser) {
    return (
      <LoginScreen 
        onLogin={(user) => setCurrentUser(user)} 
        adminPassword={adminPassword}
        completedStudents={completedStudents}
        logoUrl={logoUrl}
        showToast={showToast}
      />
    );
  }

  return (
    <div className="min-h-screen bg-slate-50 font-sans text-slate-800">
      {/* Global Toast */}
      {toastMessage && (
        <div className="fixed top-4 right-4 bg-emerald-600 text-white px-6 py-3 rounded-lg shadow-xl z-50 animate-bounce">
          {toastMessage}
        </div>
      )}

      {/* Main Routing via State */}
      {currentUser.role === 'admin' ? (
        <AdminDashboard 
          questions={questions} setQuestions={setQuestions}
          logoUrl={logoUrl} setLogoUrl={setLogoUrl}
          adminPassword={adminPassword} setAdminPassword={setAdminPassword}
          onLogout={handleLogout}
          showToast={showToast}
          onTestRun={() => {
            setCurrentUser({ role: 'admin_preview', name: 'Admin (Uji Coba)', class: 'Admin' });
            setQuizState('intro');
          }}
        />
      ) : (
        <StudentView 
          currentUser={currentUser}
          quizState={quizState} setQuizState={setQuizState}
          questions={questions}
          userAnswers={userAnswers} setUserAnswers={setUserAnswers}
          timeRemaining={timeRemaining}
          startQuiz={startQuiz}
          submitQuiz={submitQuiz}
          score={score}
          logoUrl={logoUrl}
          onLogout={handleLogout}
        />
      )}
    </div>
  );
}


function LoginScreen({ onLogin, adminPassword, completedStudents, logoUrl, showToast }) {
  const [tab, setTab] = useState('student');
  
  // Student Form
  const [name, setName] = useState('');
  const [kelas, setKelas] = useState('');
  const [presensi, setPresensi] = useState('');

  // Admin Form
  const [adminUser, setAdminUser] = useState('');
  const [adminPass, setAdminPass] = useState('');

  const handleStudentLogin = (e) => {
    e.preventDefault();
    if (!name.trim() || !kelas || !presensi) {
      showToast('Harap lengkapi semua data!');
      return;
    }
    
    const studentKey = `${name.trim()}_${kelas}`;
    if (completedStudents[studentKey]) {
      showToast('Siswa ini sudah mengerjakan asesmen (hanya boleh 1 kali).');
      return;
    }

    onLogin({
      role: 'student',
      name: name.trim(),
      class: kelas,
      presensi: presensi
    });
  };

  const handleAdminLogin = (e) => {
    e.preventDefault();
    if (adminUser === 'admin' && adminPass === adminPassword) {
      onLogin({ role: 'admin' });
    } else {
      showToast('Username atau password admin salah!');
    }
  };

  return (
