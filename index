function AdminQuestionEditor({ q, idx, updateQuestion }) {
  const [isExpanded, setIsExpanded] = useState(false);
  const [localQ, setLocalQ] = useState(q);

  const handleSave = () => {
    updateQuestion(localQ);
    setIsExpanded(false);
  };

  const typeLabels = {
    'pg': 'Pilihan Ganda',
    'pg_kompleks': 'Pilihan Ganda Kompleks',
    'matching': 'Menjodohkan',
    'isian': 'Isian Singkat'
  };

  return (
    <div className="border rounded-lg overflow-hidden bg-slate-50">
      <div 
        className="flex justify-between items-center p-4 bg-white cursor-pointer hover:bg-slate-50"
        onClick={() => setIsExpanded(!isExpanded)}
      >
        <div className="flex items-center gap-4">
          <span className="bg-slate-800 text-white w-8 h-8 flex items-center justify-center rounded-full font-bold text-sm">{idx + 1}</span>
          <div>
            <div className="text-xs font-semibold text-emerald-600 uppercase tracking-wider mb-1">{typeLabels[localQ.type]}</div>
            <div className="font-medium text-slate-800 line-clamp-1">{localQ.text}</div>
          </div>
        </div>
        <button className="text-slate-400 hover:text-slate-700">
          {isExpanded ? 'Tutup' : 'Edit'}
        </button>
      </div>

      {isExpanded && (
        <div className="p-4 border-t border-slate-200 space-y-4">
          <div>
            <label className="block text-xs font-bold text-slate-500 mb-1 uppercase">Teks Soal</label>
            <textarea 
              value={localQ.text} 
              onChange={e => setLocalQ({...localQ, text: e.target.value})}
              className="w-full p-2 border rounded-md" rows="3"
            />
          </div>

          {/* Editor based on Type */}
          {localQ.type === 'pg' && (
            <div>
              <label className="block text-xs font-bold text-slate-500 mb-2 uppercase">Pilihan Jawaban</label>
              {localQ.options.map((opt, oIdx) => (
                <div key={oIdx} className="flex gap-2 mb-2 items-center">
                  <input 
                    type="radio" 
                    checked={localQ.answer === opt}
                    onChange={() => setLocalQ({...localQ, answer: opt})}
                    className="w-4 h-4"
                  />
                  <input 
                    type="text" 
                    value={opt}
                    onChange={e => {
                      const newOpts = [...localQ.options];
                      newOpts[oIdx] = e.target.value;
                      // Update answer if the modified option was the correct one
                      const newAnswer = (localQ.answer === opt) ? e.target.value : localQ.answer;
                      setLocalQ({...localQ, options: newOpts, answer: newAnswer});
                    }}
                    className="flex-1 p-2 border rounded-md text-sm"
                  />
                </div>
              ))}
            </div>
          )}

          {localQ.type === 'pg_kompleks' && (
            <div>
               <label className="block text-xs font-bold text-slate-500 mb-2 uppercase">Pilihan Jawaban (Centang yang benar)</label>
               {localQ.options.map((opt, oIdx) => (
                <div key={oIdx} className="flex gap-2 mb-2 items-center">
                  <input 
                    type="checkbox" 
                    checked={localQ.answer.includes(opt)}
                    onChange={(e) => {
                      let newAns = [...localQ.answer];
                      if(e.target.checked) newAns.push(opt);
                      else newAns = newAns.filter(a => a !== opt);
                      setLocalQ({...localQ, answer: newAns});
                    }}
                    className="w-4 h-4 rounded"
                  />
                  <input 
                    type="text" 
                    value={opt}
                    onChange={e => {
                      const newOpts = [...localQ.options];
                      newOpts[oIdx] = e.target.value;
                      
                      let newAns = [...localQ.answer];
                      const ansIdx = newAns.indexOf(opt);
                      if (ansIdx > -1) newAns[ansIdx] = e.target.value;

                      setLocalQ({...localQ, options: newOpts, answer: newAns});
                    }}
                    className="flex-1 p-2 border rounded-md text-sm"
                  />
                </div>
              ))}
            </div>
          )}

          {localQ.type === 'matching' && (
            <div>
               <label className="block text-xs font-bold text-slate-500 mb-2 uppercase">Pasangan (Kiri - Kanan)</label>
               {localQ.pairs.map((pair, pIdx) => (
                 <div key={pIdx} className="flex gap-4 mb-2">
                    <input 
                      type="text" 
                      value={pair.left}
                      onChange={e => {
                        const newPairs = [...localQ.pairs];
                        const oldLeft = newPairs[pIdx].left;
                        newPairs[pIdx].left = e.target.value;
                        
                        const newAnswers = {...localQ.answers};
                        newAnswers[e.target.value] = newAnswers[oldLeft];
                        delete newAnswers[oldLeft];

                        setLocalQ({...localQ, pairs: newPairs, answers: newAnswers});
                      }}
                      className="flex-1 p-2 border rounded-md text-sm bg-slate-100" placeholder="Kiri"
                    />
                    <select 
                      value={localQ.answers[pair.left] || ''}
                      onChange={e => {
                        const newAnswers = {...localQ.answers};
                        newAnswers[pair.left] = e.target.value;
                        setLocalQ({...localQ, answers: newAnswers});
                      }}
                      className="flex-1 p-2 border rounded-md text-sm"
                    >
                      <option value="" disabled>Pilih Pasangan...</option>
                      {localQ.optionsRight.map(opt => <option key={opt} value={opt}>{opt}</option>)}
                    </select>
                 </div>
               ))}
               <div className="mt-4">
                 <label className="block text-xs font-bold text-slate-500 mb-2 uppercase">Daftar Pilihan Kanan (Pisahkan dengan koma)</label>
                 <textarea 
                    value={localQ.optionsRight.join(', ')}
                    onChange={e => {
                      const opts = e.target.value.split(',').map(s => s.trim()).filter(Boolean);
                      setLocalQ({...localQ, optionsRight: opts});
                    }}
                    className="w-full p-2 border rounded-md text-sm" rows="2"
                 />
               </div>
            </div>
          )}

          {localQ.type === 'isian' && (
            <div>
               <label className="block text-xs font-bold text-slate-500 mb-2 uppercase">Kunci Jawaban (Pisahkan dengan koma untuk variasi)</label>
               <textarea 
                  value={localQ.answer.join(', ')}
                  onChange={e => {
                    const ans = e.target.value.split(',').map(s => s.trim().toLowerCase()).filter(Boolean);
                    setLocalQ({...localQ, answer: ans});
                  }}
                  className="w-full p-2 border rounded-md text-sm" rows="2"
                  placeholder="Misal: bilik kiri, ventrikel kiri"
               />
               <p className="text-xs text-slate-400 mt-1">Jawaban siswa akan diubah huruf kecil semua (lowercase) sebelum dicocokkan.</p>
            </div>
          )}

          <div className="flex justify-end pt-2">
            <button onClick={handleSave} className="bg-emerald-600 text-white px-4 py-2 rounded-md text-sm font-medium hover:bg-emerald-700">Simpan Perubahan Soal Ini</button>
          </div>
        </div>
      )}
    </div>
  );
}


